PORT=3001
DB_FILE=./data/farm.db.json
CORS_ORIGIN=http://localhost:8080

# MySQL / Laragon example
# To use MySQL with Laragon, set DB_MODE=mysql and provide the connection details below.
# Uncomment and adjust as needed when using MySQL instead of the default JSON store.
# DB_MODE=mysql
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/farm_db
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=farm_db
